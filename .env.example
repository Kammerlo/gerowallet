# GeroWallet Environment Configuration
# Copy this file to .env, .env.development, .env.production, or .env.beta
# and fill in your own values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application name displayed in the extension
VITE_APP_NAME='GeroWallet - Your Master Key to DeFi'

# Backend API URL
# Development: http://localhost:8081
# Production: https://api.gerowallet.io
VITE_BACKEND_URL=https://api.gerowallet.io

# Beta flag (true for beta releases)
VITE_IS_BETA=false

# Debug mode for store operations
VITE_DEBUG_STORES=false

# =============================================================================
# FIAT ON-RAMP SERVICES
# =============================================================================

# MoonPay API Key (get from https://dashboard.moonpay.com)
# Use pk_test_* for development, pk_live_* for production
VITE_MOONPAY_API_KEY=pk_test_your_moonpay_key_here

# Guardarian API Key (get from https://guardarian.com/for-partners)
VITE_GUARDARIAN_API_KEY=your_guardarian_api_key_here

# =============================================================================
# REAL-TIME SERVICES
# =============================================================================

# Gero Sync WebSocket URL (native WebSocket sync service)
VITE_SYNC_WS_URL=wss://sync.gerowallet.io

# Kraken WebSocket (public, no key needed)
VITE_KRAKEN_API_URL=https://api.kraken.com
VITE_KRAKEN_WS_URL=wss://ws.kraken.com

# =============================================================================
# GOOGLE AUTHENTICATION
# =============================================================================

# Google OAuth Client ID (get from https://console.cloud.google.com)
# Required for Google Wallet feature
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# =============================================================================
# LEGACY ZK SMART WALLET INTEGRATION (unused — retained for reference)
# =============================================================================

# legacy hosted endpoints — unused, retained for reference
VITE_ZK_SMART_WALLET_API_URL=
VITE_ZK_SMART_WALLET_PROVER_URL=
VITE_ZK_SMART_WALLET_API_KEY=your_zk_smart_wallet_api_key_here

# Use mock proof for faster development (skip 2-3 min proof generation)
VITE_USE_MOCK_PROOF=false

# =============================================================================
# KAISEREX / GERO CARD
# =============================================================================

# KaiserEx OAuth URL (for Gero Card integration)
VITE_KAISEREX_OAUTH_URL=https://oauth-sa.kaiserex.com

# =============================================================================
# CASHBACK INTEGRATION
# =============================================================================

# Bring Cashback Identifier
VITE_CASHBACK_IDENTIFIER=your_cashback_identifier_here

# Cashback Environment: sandbox or prod
VITE_CASHBACK_ENVIRONMENT=sandbox

# =============================================================================
# ADA HANDLE
# =============================================================================

# ADA Handle API Base URL
VITE_ADA_HANDLE_BASE_URL=https://api.handle.me

# =============================================================================
# WALLETCONNECT
# =============================================================================

# WalletConnect / Reown project ID (get from https://dashboard.reown.com)
# REQUIRED to activate WalletConnect — the service silently no-ops when unset,
# so pairing, session proposals, and remote signing stay disabled without it.
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature flag service base URL (self-hosted gero-sync instance)
VITE_FLAGS_BASE_URL=https://sync.gerowallet.io

# Nexus is reached through gero-backend's proxy (server injects the Nexus API key).
# Point this at <gero-backend>/api/nexus, NOT at Nexus directly.
VITE_NEXUS_URL=https://api.gerowallet.io/api/nexus

# =============================================================================
# LIVE SUPPORT CHAT
# =============================================================================

# Self-hosted Chatwoot origin. The wallet talks to its PUBLIC Client API
# (/public/api/v1/inboxes/gerowallet-extension) and the ActionCable stream at
# <origin>/cable — the ws(s) URL is derived from this value. Optional: the client
# falls back to https://support.gerowallet.io when unset.
VITE_SUPPORT_CHAT_URL=https://support.gerowallet.io

# =============================================================================
# CHROME EXTENSION
# =============================================================================

# Chrome Extension Manifest Key (for consistent extension ID)
# Generate using: https://nicholasflamy.com/calculate-chrome-extension-id/
# Only needed for production releases
MANIFEST_KEY=your_manifest_key_here

# Contentful blog. Public read-only Content Delivery API token (safe to ship in
# the extension bundle). Values live in .env.development / .env.production.
VITE_CONTENTFUL_SPACE_ID=
VITE_CONTENTFUL_ACCESS_TOKEN=
VITE_CONTENTFUL_ENVIRONMENT=master

# =============================================================================
# CIP-113 PROGRAMMABLE TOKENS
# =============================================================================

# The shared `programmable_logic_base` script hash per network: every CIP-113 UTxO on
# that network sits at this payment credential, with the owner in the address's stake
# slot. Blake2b-224, 56 lowercase hex, no 0x prefix.
#
# Public on-chain constants, not secrets, and identical across build modes — so they
# live in version control and .github/workflows/ci-cd.yml copies this block into the
# generated .env.production. Do NOT move them to repo Variables.
#
# TAKEN AS GRANTED: no on-chain verification, no server allowlist. A wrong hash here is
# trusted as-is, so treat a PR touching these lines like a change to the scam blacklist.
#
# One variable per network (a single build serves all of them). Comma-separated list,
# newest deployment first — a re-bootstrap changes the hash while existing holdings stay
# at the old script, so keep superseded entries until nobody holds tokens under them.
# EMPTY means CIP-113 is unsupported on that network; it fails closed.

# Mainnet — MUST stay empty. No CIP-113 mainnet deployment exists; filling this in
# needs a reviewed, on-chain-confirmed deployment. Never copy a testnet value here.
VITE_CIP113_PROGRAMMABLE_LOGIC_BASE_MAINNET=

# Preprod. Provisional — from the reference deployment, not confirmed on-chain.
VITE_CIP113_PROGRAMMABLE_LOGIC_BASE_PREPROD=

# Preview. The 2026-08-13 re-bootstrap — the only supported preview deployment.
# Confirmed against live UTxOs.
VITE_CIP113_PROGRAMMABLE_LOGIC_BASE_PREVIEW=33ceea92481cd6cc5b9ad1750302642042bb8ea5d028b830ad86fc31
